# Copy this file to .env.local and fill in your real values.

# Google Analytics 4 Measurement ID (optional).
# Leave blank to disable analytics — the site works fine without it.
# Get one at https://analytics.google.com
NEXT_PUBLIC_GA_ID=

# Web3Forms access key for the demo request form.
# Get a free key instantly at https://web3forms.com (no signup needed to test).
# NOTE: the current placeholder lives in src/components/ui/DemoForm.tsx —
# replace WEB3FORMS_ACCESS_KEY there with your real key before going live.
